{
  "name": "outline-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @outline-dash/api --filter @outline-dash/web dev",
    "build": "pnpm --filter @outline-dash/web build",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm build && pnpm --filter @outline-dash/api run deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
